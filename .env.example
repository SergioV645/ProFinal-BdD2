# Variables de entorno que usa el backend. Defínelas en tu terminal antes de ejecutar (ver README).
# Nunca subas los valores reales al repositorio.

# Obligatorias
MYSQL_DSN=taller_app:CLAVE@tcp(127.0.0.1:3306)/taller_vehiculos?parseTime=true
MONGODB_URI=mongodb+srv://USUARIO:CLAVE@CLUSTER/aurum_nosql
SESSION_SECRET=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES

# Solo se usan la primera vez, si la tabla usuarios está vacía
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CAMBIAR_POR_UNA_CLAVE_DE_AL_MENOS_10_CARACTERES

# Opcionales
COOKIE_SECURE=false      # true si se despliega con HTTPS
PORT=8080
FRONTEND_DIR=../frontend
